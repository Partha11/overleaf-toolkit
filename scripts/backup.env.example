# Overleaf backup configuration - NON-SECRET settings.
#
# Install at /etc/overleaf-backup/backup.env (chmod 600). Secrets (R2 API keys
# and the rclone crypt passwords) live only in /etc/overleaf-backup/rclone.conf
# (see scripts/setup-r2.sh). This file may contain non-secret tuning values.
#
# All values below are the built-in defaults; uncomment/change as needed.

# Working directory for staging, outgoing archives and retained local copies.
#BACKUP_WORK_DIR=/var/lib/overleaf-backups

# rclone executable and configuration.
#RCLONE_BIN=rclone
#RCLONE_CONFIG=/etc/overleaf-backup/rclone.conf

# Crypt remote name (set up by scripts/setup-r2.sh) and the path inside the
# dedicated bucket where backups are stored. Deletion logic in the retention
# pass never operates outside this path.
#RCLONE_REMOTE=r2-crypt
#R2_BACKUP_PATH=overleaf

# Retention policy (counts of distinct restore points kept on R2).
#RETENTION_DAILY=7
#RETENTION_WEEKLY=4
#RETENTION_MONTHLY=6

# How many of the most recent archives to keep locally after a successful upload.
#LOCAL_KEEP=3

# Minimum free space (bytes) required in BACKUP_WORK_DIR before starting.
#MIN_FREE_SPACE=1073741824

# Stop the sharelatex container during capture for a consistent point-in-time
# backup. Leave true unless you accept weaker consistency.
#QUIESCE=true

# MongoDB database name inside the toolkit mongo container.
#MONGO_DB=sharelatex
