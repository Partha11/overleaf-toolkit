link(rel='manifest' href=buildBaseAssetPath() + 'web.sitemanifest')

//- Theme meta fallback for Community Edition
- if (typeof overallThemes === 'undefined' || !overallThemes || !overallThemes.length) overallThemes = [{ name: 'Dark', val: '' }, { name: 'Light', val: 'light-' }, { name: 'System', val: 'system' }]
- if (typeof splitTestVariants === 'undefined' || !splitTestVariants) { splitTestVariants = {}; }
- splitTestVariants['themed-project-dashboard'] = 'enabled';
- let userOverallTheme = ''
- try { if (typeof getSessionUser === 'function' && getSessionUser()) { const su = getSessionUser(); userOverallTheme = (su.ace && su.ace.overallTheme) || ''; } } catch(e) {}
meta(name='ol-overallThemes' data-type='json' content=overallThemes)
meta(name='ol-serverOverallTheme' content=userOverallTheme)

//- Theme initialization & marketing navbar enhancement script
script(nonce=scriptNonce).
	(function() {
		function getSavedTheme() {
			try {
				var metaServer = document.querySelector('meta[name="ol-serverOverallTheme"]');
				if (metaServer && metaServer.getAttribute('content') !== null && metaServer.getAttribute('content') !== '') {
					return metaServer.getAttribute('content');
				}
			} catch(e) {}
			try {
				var metaEl = document.querySelector('meta[name="ol-userSettings"]');
				if (metaEl) {
					var s = JSON.parse(metaEl.getAttribute('content') || '{}');
					if (s.overallTheme !== undefined && s.overallTheme !== null) return s.overallTheme;
				}
			} catch(e) {}
			try {
				var st = localStorage.getItem('overallTheme');
				if (st) return JSON.parse(st);
			} catch(e) {}
			return '';
		}

		function applyTheme(th) {
			var isDark = true;
			if (th === 'light-') {
				isDark = false;
			} else if (th === 'system') {
				isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
			}
			var t = isDark ? 'default' : 'light';
			document.documentElement.dataset.theme = t;
			if (document.body) {
				document.body.dataset.theme = t;
			}
			return t;
		}

		var initialTheme = getSavedTheme();
		var curTargetTheme = applyTheme(initialTheme);

		if (typeof MutationObserver !== 'undefined') {
			var bodyObserver = new MutationObserver(function() {
				if (document.body) {
					document.body.dataset.theme = curTargetTheme;
					bodyObserver.disconnect();
				}
			});
			bodyObserver.observe(document.documentElement, { childList: true });
		}

		// Global Cloverleaf user dropdown menu specification
		window.CLOVERLEAF_USER_MENU = [
			{ type: 'header' },
			{ type: 'divider' },
			{ type: 'link', text: 'Account Settings', href: '/user/settings' },
			{ type: 'admin', text: 'Manage Site', href: '/admin' },
			{ type: 'admin', text: 'Manage Users', href: '/admin/user' },
			{ type: 'admin', text: 'Project URL Lookup', href: '/admin/project' },
			{ type: 'divider' },
			{ type: 'logout', text: 'Log Out' }
		];

		window.renderCloverleafUserMenu = function(menuContainer, options) {
			if (!menuContainer) return;
			options = options || {};
			var email = options.email || document.querySelector('meta[name="ol-usersEmail"]')?.getAttribute('content') || 'Admin';
			var csrf = options.csrf || document.querySelector('meta[name="ol-csrfToken"]')?.getAttribute('content') || document.querySelector('input[name="_csrf"]')?.value || '';
			var isAdmin = options.isAdmin !== undefined ? options.isAdmin : true;

			var html = '';
			html += '<li role="none" class="dropdown-item disabled text-truncate" style="max-width: 240px; font-size: 13px; opacity: 0.75; font-weight: 500;">' + email + '</li>';
			html += '<li role="separator" class="dropdown-divider d-none d-lg-block"></li>';
			html += '<li role="none"><a class="dropdown-item" role="menuitem" href="/user/settings">Account Settings</a></li>';
			if (isAdmin) {
				html += '<li role="none"><a class="dropdown-item" role="menuitem" href="/admin">Manage Site</a></li>';
				html += '<li role="none"><a class="dropdown-item" role="menuitem" href="/admin/user">Manage Users</a></li>';
				html += '<li role="none"><a class="dropdown-item" role="menuitem" href="/admin/project">Project URL Lookup</a></li>';
			}
			html += '<li role="separator" class="dropdown-divider d-none d-lg-block"></li>';
			html += '<li role="none">';
			html += '  <button class="btn-link text-left dropdown-menu-button dropdown-item d-flex align-items-center justify-content-between w-100" role="menuitem" tabindex="-1" form="globalLogOutForm">';
			html += '    <span>Log Out</span>';
			html += '  </button>';
			html += '  <form method="POST" action="/logout" id="globalLogOutForm" style="display:none;">';
			html += '    <input name="_csrf" type="hidden" value="' + csrf + '">';
			html += '  </form>';
			html += '</li>';

			menuContainer.innerHTML = html;
		};

		function initMarketingNav() {
			var curT = applyTheme(getSavedTheme());
			// React manages its own navbar on pages with meta[name="ol-navbar"] (e.g. /project, /user/settings)
			if (document.querySelector('meta[name="ol-navbar"]')) return;

			var navRight = document.querySelector('nav.navbar .navbar-nav.navbar-right, nav.navbar .navbar-nav.ms-auto');
			if (!navRight) return;

			// 1. Remove separate "Account" button
			Array.from(navRight.children).forEach(function(li) {
				var btn = li.querySelector('.dropdown-toggle, a');
				if (btn && btn.textContent.trim().toLowerCase().startsWith('account')) {
					li.remove();
				}
			});

			// 2. Docs link
			var docsLi = navRight.querySelector('.nav-item-docs');
			if (!docsLi) {
				docsLi = document.createElement('li');
				docsLi.className = 'nav-item nav-item-docs';
				docsLi.innerHTML = '<a class="nav-link docs-link" href="https://www.overleaf.com/learn" target="_blank" rel="noopener noreferrer">Docs</a>';
			}

			// 3. Theme Quick Toggle
			var themeLi = navRight.querySelector('.nav-item-theme');
			if (!themeLi) {
				themeLi = document.createElement('li');
				themeLi.className = 'nav-item nav-item-theme';
				var isLight = curT === 'light';
				themeLi.innerHTML = '<button type="button" class="theme-quick-toggle" title="' + (isLight ? 'Switch to dark theme' : 'Switch to light theme') + '" aria-label="' + (isLight ? 'Switch to dark theme' : 'Switch to light theme') + '"><span class="material-symbols" aria-hidden="true" translate="no">' + (isLight ? 'dark_mode' : 'light_mode') + '</span></button>';
				var themeBtn = themeLi.querySelector('.theme-quick-toggle');
				themeBtn.addEventListener('click', function() {
					var cur = (document.body && document.body.dataset.theme === 'light') || document.documentElement.dataset.theme === 'light';
					var nextTheme = cur ? '' : 'light-';
					var nextTarget = cur ? 'default' : 'light';
					curTargetTheme = nextTarget;
					document.documentElement.dataset.theme = nextTarget;
					if (document.body) document.body.dataset.theme = nextTarget;
					try { localStorage.setItem('overallTheme', JSON.stringify(nextTheme)); } catch(e) {}
					var icon = themeBtn.querySelector('.material-symbols');
					if (icon) icon.textContent = cur ? 'light_mode' : 'dark_mode';
					var newTitle = cur ? 'Switch to light theme' : 'Switch to dark theme';
					themeBtn.title = newTitle;
					themeBtn.setAttribute('aria-label', newTitle);

					var logos = document.querySelectorAll('.navbar-logo');
					logos.forEach(function(l) {
						l.style.backgroundImage = nextTarget === 'light' 
							? 'url("/img/ol-brand/cloverleaf-header-logo-light.svg")' 
							: 'url("/img/ol-brand/cloverleaf-header-logo.svg")';
					});

					try {
						var csrf = document.querySelector('meta[name="ol-csrfToken"]')?.getAttribute('content') ||
						           document.querySelector('input[name="_csrf"]')?.value || '';
						fetch('/user/settings', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
							body: JSON.stringify({ overallTheme: nextTheme })
						});
					} catch(e) {}
				});
			}

			// 4. Projects link
			var projectsLi = Array.from(navRight.children).find(function(li) {
				var a = li.querySelector('a');
				return a && (a.getAttribute('href') === '/project' || a.textContent.trim().toLowerCase() === 'projects');
			});

			// 5. Avatar dropdown
			var adminLi = navRight.querySelector('.dropdown.subdued, .nav-item-admin-avatar');
			if (adminLi) {
				adminLi.classList.add('nav-item-admin-avatar');
				var adminToggle = adminLi.querySelector('.dropdown-toggle');
				var userEmailMeta = document.querySelector('meta[name="ol-usersEmail"]');
				var email = userEmailMeta?.getAttribute('content') || 'Admin';
				var namePart = email.split('@')[0];
				var raw = namePart.replace(/[^a-zA-Z0-9._\\s-]/g, '');
				var parts = raw.split(/[._\\s-]+/).filter(Boolean);
				var inits = 'AD';
				if (parts.length >= 2) inits = (parts[0][0] + parts[1][0]).toUpperCase();
				else if (parts.length === 1 && parts[0].length >= 2) inits = parts[0].slice(0, 2).toUpperCase();
				else if (parts.length === 1) inits = parts[0][0].toUpperCase();

				if (adminToggle) {
					adminToggle.innerHTML = '<div class="navbar-avatar-circle" title="' + email + '">' + inits + '</div>';
				}

				var menuUl = adminLi.querySelector('.dropdown-menu');
				if (menuUl && window.renderCloverleafUserMenu) {
					var csrf = document.querySelector('meta[name="ol-csrfToken"]')?.getAttribute('content') || document.querySelector('input[name="_csrf"]')?.value || '';
					window.renderCloverleafUserMenu(menuUl, { email: email, csrf: csrf, isAdmin: true });
				}
			}

			// Reorder items in navRight: Docs -> Theme Toggle -> Projects -> Avatar
			navRight.appendChild(docsLi);
			navRight.appendChild(themeLi);
			if (projectsLi) navRight.appendChild(projectsLi);
			if (adminLi) navRight.appendChild(adminLi);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initMarketingNav);
		} else {
			initMarketingNav();
		}
	})();

//- Polished Navbar, Branding, and Theme Styles
//- Bump the filename and Docker mount together when changing this cached CSS.
link(
	rel='stylesheet'
	href=buildBaseAssetPath() + 'stylesheets/cloverleaf-overrides-v4.css'
)
