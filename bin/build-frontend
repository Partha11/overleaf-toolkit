#! /usr/bin/env bash
# Rebuild the Overleaf web frontend inside a throwaway container and copy the
# resulting assets to data/public-build, which is bind-mounted into the running
# sharelatex container (see overrides/docker-compose.override.yml).
#
# This is needed because data/ is gitignored and the frontend bundle is compiled
# at image build time. The override themes (overrides/github_dark.json) must be
# compiled into the bundle, so the bundle is rebuilt whenever the image version
# changes or the custom themes are edited.
#
# Usage: bin/build-frontend

set -euo pipefail

#### Detect Toolkit Project Root ####
command -v realpath >/dev/null 2>&1 || realpath() {
  [[ $1 = /* ]] && echo "$1" || echo "$PWD/${1#./}"
}
SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
TOOLKIT_ROOT="$(realpath "$SCRIPT_DIR/..")"
if [[ ! -d "$TOOLKIT_ROOT/bin" ]] || [[ ! -d "$TOOLKIT_ROOT/config" ]]; then
  echo "ERROR: could not find root of overleaf-toolkit project (inferred project root as '$TOOLKIT_ROOT')"
  exit 1
fi

source "$TOOLKIT_ROOT/lib/shared-functions.sh"

function check_config() {
  if [[ ! -f "$TOOLKIT_ROOT/config/overleaf.rc" ]] \
      || [[ ! -f "$TOOLKIT_ROOT/config/version" ]]; then
    echo "Config files not found! Please run bin/init first."
    exit 1
  fi
}

function ensure_build_container() {
  docker run -d --name "$BUILD_CONTAINER" --entrypoint sleep "$IMAGE" infinity
}

# Report the package manager to use for the frontend build. If the repo declares
# one ("packageManager" field in /overleaf/package.json, e.g. "yarn@4.5.0") and
# it is present in the image, use it - other managers (pnpm) refuse to run
# against a project with a different declared manager. Otherwise fall back to
# probing pnpm, then yarn, then npm.
function detect_package_manager() {
  local declared pkg
  declared="$(
    docker exec "$BUILD_CONTAINER" node -e \
      "try { const p = require('/overleaf/package.json'); console.log((p.packageManager || '').split('@')[0]) } catch (e) {}" \
      2>/dev/null || true
  )"
  if [[ -n "$declared" ]]; then
    if docker exec "$BUILD_CONTAINER" sh -c "command -v $declared" >/dev/null 2>&1; then
      echo "$declared"
      return 0
    fi
    echo "ERROR: /overleaf/package.json declares '$declared' but it is not" >&2
    echo "  installed in image $IMAGE. Install it or use a different image." >&2
    return 1
  fi
  for pkg in pnpm yarn npm; do
    if docker exec "$BUILD_CONTAINER" sh -c "command -v $pkg" >/dev/null 2>&1; then
      echo "$pkg"
      return 0
    fi
  done
  return 1
}

function main() {
  read_image_version
  read_config
  check_config
  set_server_pro_image_name "$IMAGE_VERSION"
  export IMAGE

  BUILD_CONTAINER="overleaf-build-$$"
  THEME_SRC="/overleaf/services/web/frontend/js/features/source-editor/themes/cm6"
  PUBLIC_DIR="$TOOLKIT_ROOT/data/public-build"
  OVERRIDES_DIR="$TOOLKIT_ROOT/overrides"

  if [[ ! -f "$OVERRIDES_DIR/github_dark.json" ]]; then
    echo "ERROR: $OVERRIDES_DIR/github_dark.json not found"
    exit 1
  fi

  echo "Building frontend for image: $IMAGE"
  echo "Creating build container..."
  ensure_build_container

  cleanup() {
    docker rm -f "$BUILD_CONTAINER" >/dev/null 2>&1 || true
  }
  trap cleanup EXIT

  echo "Copying custom theme into build container..."
  docker cp "$OVERRIDES_DIR/github_dark.json" \
    "$BUILD_CONTAINER:$THEME_SRC/github_dark.json"

  local pkg_manager install_cmd build_cmd
  if ! pkg_manager="$(detect_package_manager)"; then
    echo "ERROR: no package manager (pnpm, yarn or npm) found in image $IMAGE" >&2
    echo "  Install pnpm, yarn or npm in the image, or use a different image tag." >&2
    exit 1
  fi
  echo "Using package manager: $pkg_manager"

  case "$pkg_manager" in
    pnpm)
      install_cmd="cd /overleaf && pnpm install"
      build_cmd="cd /overleaf/services/web && NODE_OPTIONS=--max-old-space-size=6144 pnpm run webpack:production"
      ;;
    yarn)
      install_cmd="cd /overleaf && yarn install"
      build_cmd="cd /overleaf/services/web && NODE_OPTIONS=--max-old-space-size=6144 yarn run webpack:production"
      ;;
    npm)
      install_cmd="cd /overleaf && npm install"
      build_cmd="cd /overleaf/services/web && NODE_OPTIONS=--max-old-space-size=6144 npm run webpack:production"
      ;;
  esac

  echo "Restoring dev dependencies ($pkg_manager install)..."
  docker exec "$BUILD_CONTAINER" sh -c "$install_cmd"

  echo "Running webpack production build..."
  docker exec "$BUILD_CONTAINER" sh -c "$build_cmd"

  echo "Copying built assets to $PUBLIC_DIR ..."
  mkdir -p "$PUBLIC_DIR"
  # docker-compose creates missing bind-mount targets as root (see
  # config/docker-compose.override.yml), which blocks the copy below. Reclaim
  # ownership of public-build only; mongo/redis/overleaf data dirs are
  # intentionally owned by their service users and are left untouched.
  if [[ ! -w "$PUBLIC_DIR" ]]; then
    echo "Fixing ownership of $PUBLIC_DIR (currently root-owned)..."
    if ! sudo -n chown -R "$(id -u):$(id -g)" "$PUBLIC_DIR" 2>/dev/null; then
      echo "ERROR: $PUBLIC_DIR is not writable by user $(id -u)" >&2
      echo "  and passwordless sudo is unavailable. Fix ownership first:" >&2
      echo "  sudo chown -R $(id -u):$(id -g) $PUBLIC_DIR" >&2
      exit 1
    fi
  fi
  rm -rf "$PUBLIC_DIR"/*
  docker cp "$BUILD_CONTAINER:/overleaf/services/web/public/." "$PUBLIC_DIR"

  echo "Done."
  echo
  echo "Recreate the sharelatex container to pick up the new build:"
  echo "  bin/docker-compose up -d sharelatex"
}

main "$@"
